# Development works without this file. Copy it to .env only when customizing Compose.
EXITROUTE_PORT=8000
EXITROUTE_ENVIRONMENT=development
EXITROUTE_PUBLIC_BASE_URL=http://localhost:8000

# Replace every value below with an independently generated secret before production.
# `python -c "import secrets; print(secrets.token_urlsafe(48))"`
EXITROUTE_BOOTSTRAP_ADMIN_ENABLED=true
EXITROUTE_BOOTSTRAP_ADMIN_TOKEN=dev-bootstrap-token-change-me
EXITROUTE_API_KEY_PEPPER=dev-key-pepper-change-me-32-bytes
EXITROUTE_CURSOR_SECRET=dev-cursor-secret-change-me-32-bytes
EXITROUTE_WEBHOOK_MASTER_SECRET=dev-webhook-secret-change-me-32-bytes

# Compose database defaults. Use a URL-encoded password in EXITROUTE_DATABASE_URL.
POSTGRES_DB=exitroute
POSTGRES_USER=exitroute
POSTGRES_PASSWORD=exitroute
EXITROUTE_DATABASE_URL=postgresql+psycopg://exitroute:exitroute@database:5432/exitroute
